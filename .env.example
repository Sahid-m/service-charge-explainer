# Copy to .env.local and fill in

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string, 32+ chars, used to encrypt the session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional: public URL of the app (e.g. https://your-app.vercel.app).
# If unset, the redirect URI is built from the incoming request's origin.
APP_URL=

# TrueLayer Data API (console.truelayer.com → App settings; separate keys per environment)
# TRUELAYER_ENV picks which pair is used: "sandbox" (default) or "live"
TRUELAYER_ENV=sandbox
TRUELAYER_SANDBOX_CLIENT_ID=
TRUELAYER_SANDBOX_CLIENT_SECRET=
TRUELAYER_LIVE_CLIENT_ID=
TRUELAYER_LIVE_CLIENT_SECRET=

# OpenAI (document reading + owner reply). Model defaults to gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
